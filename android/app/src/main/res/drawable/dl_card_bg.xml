<?xml version="1.0" encoding="utf-8"?>
<!-- 下载进度卡片：深色微渐变 + 一圈细描边，叠在深色页面上有层次但不刺眼 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:startColor="#263D55"
        android:centerColor="#1E3247"
        android:endColor="#17293A"
        android:angle="270" />
    <stroke
        android:width="1dp"
        android:color="#2C4661" />
</shape>
